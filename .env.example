# =============================================================
# SkyLog — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# ---------------- AI Provider ----------------
# Anthropic Claude (primary) — get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Custom OpenAI-compatible API endpoint (optional)
# Leave empty to use Anthropic directly.
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_API_MODEL=

# ---------------- Database ----------------
POSTGRES_USER=skylog
# REQUIRED: set a strong password before starting
POSTGRES_PASSWORD=
POSTGRES_DB=skylog
DATABASE_URL=postgresql://skylog:CHANGE_ME@postgres:5432/skylog

# ---------------- Redis ----------------
REDIS_URL=redis://redis:6379

# ---------------- Auth ----------------
# REQUIRED: random string, minimum 32 characters
# Generate: openssl rand -hex 32
JWT_SECRET=

# ---------------- API Service ----------------
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---------------- Web Service ----------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ---------------- Sandbox ----------------
SANDBOX_CONTAINER=skylog-sandbox-1