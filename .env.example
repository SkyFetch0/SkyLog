# =============================================================
# SkyLog — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# ---------------- AI Provider ----------------
# Anthropic Claude (primary)
ANTHROPIC_API_KEY=sk-ant-...

# Custom OpenAI-compatible API endpoint (optional)
# Leave empty to use Anthropic directly.
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_API_MODEL=

# ---------------- Database ----------------
POSTGRES_USER=skylog
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=skylog
DATABASE_URL=postgresql://skylog:change_me_in_production@postgres:5432/skylog

# ---------------- Redis ----------------
REDIS_URL=redis://redis:6379

# ---------------- API Service ----------------
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# ---------------- Web Service ----------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------- Sandbox ----------------
SANDBOX_WORKDIR=/workspace